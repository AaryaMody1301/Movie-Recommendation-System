# Flask configuration
FLASK_APP=wsgi.py
FLASK_ENV=development
SECRET_KEY=change-me

# Database settings
DATABASE_URI=sqlite:///instance/movie_recommender.db

# CSV file paths
MOVIES_CSV=data/movies.csv
RATINGS_CSV=data/ratings.csv

# Model settings
CONTENT_MODEL_PATH=instance/content_model.pkl
COLLAB_MODEL_PATH=instance/collaborative_model.pkl
MAX_EMBEDDING_MOVIES=1000
TRANSFORMER_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Recommendation settings
MAX_RECOMMENDATIONS=10
CONTENT_WEIGHT=0.5
COLLAB_WEIGHT=0.5
TEST_SIZE=0.2
RANDOM_STATE=42
N_FACTORS=100

# TMDb integration
TMDB_API_KEY=
TMDB_REQUEST_TIMEOUT=10

# Logging and cache
LOG_LEVEL=INFO
CACHE_TYPE=SimpleCache
CACHE_DEFAULT_TIMEOUT=300

# Upload folder
UPLOAD_FOLDER=instance/uploads
