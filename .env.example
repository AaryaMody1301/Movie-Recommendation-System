# Flask configuration
FLASK_APP=wsgi.py
FLASK_ENV=development
SECRET_KEY=change-me

# Database settings
# Relative SQLite paths are resolved inside Flask's instance directory.
DATABASE_URI=sqlite:///movie_recommender.db

# CSV file paths
# RATINGS_CSV is baseline/offline data only; online personalization uses SQLAlchemy ratings.
MOVIES_CSV=data/movies.csv
RATINGS_CSV=data/ratings.csv

# Model settings
CONTENT_MODEL_PATH=instance/content_model.pkl
EMBEDDINGS_CACHE_PATH=instance/embeddings_cache.pkl
EMBEDDING_BATCH_SIZE=32
COLLAB_MODEL_PATH=instance/collaborative_model.pkl
TRANSFORMER_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Recommendation settings
MAX_RECOMMENDATIONS=10
CONTENT_WEIGHT=0.5
COLLAB_WEIGHT=0.5
PERSONALIZATION_MIN_RATING=3.5
COLLAB_CANDIDATE_POOL=200
COLLAB_MIN_RATINGS=5
COLLAB_MIN_USERS=2
COLLAB_MIN_ITEMS=2
N_FACTORS=100
COLLAB_N_EPOCHS=20
COLLAB_LR_ALL=0.005
COLLAB_REG_ALL=0.02
TEST_SIZE=0.2
RANDOM_STATE=42

# TMDb integration
TMDB_API_KEY=
TMDB_REQUEST_TIMEOUT=10

# Logging and cache
LOG_LEVEL=INFO
CACHE_TYPE=SimpleCache
CACHE_DEFAULT_TIMEOUT=300

# Upload folder
UPLOAD_FOLDER=instance/uploads
